# Copy to .env and fill in your own keys. Never commit .env.

# Which provider each service uses. Change here to switch; no code changes.
# "fake" needs no key and no network: canned transcript, questions and report.
# Use it to build pages without spending quota.
STT_PROVIDER=groq          # groq | openai | fake
LLM_PROVIDER=gemini        # gemini | openai | fake

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=            # fallback only

STT_MODEL=whisper-large-v3
LLM_MODEL=                 # set after checking which free-tier model is available
LLM_VISION_MODEL=          # optional: tried first when reading a photo of handwriting; empty = LLM_MODEL

DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
FRONTEND_ORIGIN=http://localhost:5173

# Demo mode: AI question every 60-90 s of speech
DEMO_MODE=true

# Local development only: show subject profiles not yet marked tested in Setup
SHOW_UNTESTED_PROFILES=false
